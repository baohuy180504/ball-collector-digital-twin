<?xml version="1.0"?>
<!--
  Robot gom bong - differential drive, 2 banh chu dong o DAU, 2 banh tu xoay o CUOI.
  Quy uoc ROS: x = tien, y = trai, z = len. Don vi: m, kg, rad.

  base_link dat tren MAT SAN, ngay duoi trung diem truc 2 banh chu dong (= tam xoay).
  => Toa do (x, y, yaw) tu ArUco / odometry chinh la pose cua base_link.

  THONG SO DO THUC TE:
    Than xe        : dai 0.385 (x) x rong 0.37 (y) x cao 0.25
    Tong chieu cao : 0.30 tu mat dat -> day than cach san 0.05
    Banh chu dong  : phi 65 mm (R = 0.0325), rong 0.025
    Khoang cach tam 2 banh (track) L = 0.45 -> banh nam ngoai than, tong be ngang = 0.475

  THONG SO CON GIA DINH (can do lai):
    Truc banh cach mep truoc than 0.05 -> than xe tu x=+0.05 den x=-0.335
    Banh tu xoay co cang: banh phi 25 mm, tong cao 34 mm (do thuc te); gia dinh rong 12 mm, trail 8 mm,
    ke them mieng dem 16 mm duoi de (34 + 16 = 50 mm khe ho gam); de tai x=-0.31, y=+-0.16
    IMU tai (0, 0, 0.08); ArUco 0.192 x 0.192 tren noc, cach truc banh 17 cm ve sau (x = -0.17)
    Khoi luong: than 3.0 kg, moi banh 0.3 kg, moi banh tu xoay 0.05 kg
  R va L phai KHOP voi firmware ESP32 (dong hoc vi sai).
-->
<robot name="robot_gom_bong">

  <material name="body_gray"><color rgba="0.55 0.57 0.60 1"/></material>
  <material name="wheel_black"><color rgba="0.08 0.08 0.08 1"/></material>
  <material name="caster_white"><color rgba="0.90 0.90 0.90 1"/></material>
  <material name="caster_metal"><color rgba="0.75 0.77 0.80 1"/></material>
  <material name="spacer_dark"><color rgba="0.25 0.25 0.25 1"/></material>
  <material name="aruco_white"><color rgba="1 1 1 1"/></material>
  <material name="imu_blue"><color rgba="0.10 0.35 0.80 1"/></material>

  <!-- ===== THAN XE (gan vao base_link, lech ve phia sau tam xoay) ===== -->
  <link name="base_link">
    <visual>
      <origin xyz="-0.1425 0 0.175" rpy="0 0 0"/>
      <geometry><box size="0.385 0.37 0.25"/></geometry>
      <material name="body_gray"/>
    </visual>
    <collision>
      <origin xyz="-0.1425 0 0.175" rpy="0 0 0"/>
      <geometry><box size="0.385 0.37 0.25"/></geometry>
    </collision>
    <inertial>
      <origin xyz="-0.1425 0 0.175" rpy="0 0 0"/>
      <mass value="3.0"/>
      <!-- hop dac: I = m/12 * (a^2 + b^2) -->
      <inertia ixx="0.04985" ixy="0" ixz="0" iyy="0.05268" iyz="0" izz="0.07128"/>
    </inertial>
  </link>

  <!-- ===== BANH CHU DONG TRAI ===== -->
  <link name="left_wheel_link">
    <visual>
      <origin xyz="0 0 0" rpy="1.5708 0 0"/>
      <geometry><cylinder radius="0.0325" length="0.025"/></geometry>
      <material name="wheel_black"/>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="1.5708 0 0"/>
      <geometry><cylinder radius="0.0325" length="0.025"/></geometry>
    </collision>
    <inertial>
      <mass value="0.3"/>
      <!-- truc quay = y: Iyy = m r^2 / 2 ; Ixx = Izz = m/12 (3r^2 + h^2) -->
      <inertia ixx="0.0000948" ixy="0" ixz="0" iyy="0.0001584" iyz="0" izz="0.0000948"/>
    </inertial>
  </link>
  <joint name="left_wheel_joint" type="continuous">
    <parent link="base_link"/>
    <child link="left_wheel_link"/>
    <origin xyz="0 0.225 0.0325" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <limit effort="2.0" velocity="25.0"/>
    <dynamics damping="0.01" friction="0.0"/>
  </joint>

  <!-- ===== BANH CHU DONG PHAI ===== -->
  <link name="right_wheel_link">
    <visual>
      <origin xyz="0 0 0" rpy="1.5708 0 0"/>
      <geometry><cylinder radius="0.0325" length="0.025"/></geometry>
      <material name="wheel_black"/>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="1.5708 0 0"/>
      <geometry><cylinder radius="0.0325" length="0.025"/></geometry>
    </collision>
    <inertial>
      <mass value="0.3"/>
      <inertia ixx="0.0000948" ixy="0" ixz="0" iyy="0.0001584" iyz="0" izz="0.0000948"/>
    </inertial>
  </link>
  <joint name="right_wheel_joint" type="continuous">
    <parent link="base_link"/>
    <child link="right_wheel_link"/>
    <origin xyz="0 -0.225 0.0325" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <limit effort="2.0" velocity="25.0"/>
    <dynamics damping="0.01" friction="0.0"/>
  </joint>

  <!-- ===== BANH TU XOAY CO CANG (swivel caster) x 2, goc sau duoi than =====
       Caster that: banh phi 25 mm, tong cao 34 mm. Khe ho gam = 50 mm
       -> can mieng dem 16 mm (z = 0.034 .. 0.050) de 4 diem cham cung mat san.
       Moi caster: dem + de (fixed) -> cang (continuous, truc z) -> banh (continuous, truc y).
       Gia dinh: banh rong 12 mm, do lech truc (trail) 8 mm,
       tam de cach mep sau / mep hong 25 mm -> (x=-0.31, y=+-0.16). -->

  <!-- Caster trai -->
  <link name="left_caster_plate">
    <visual>
      <origin xyz="0 0 0.0015" rpy="0 0 0"/>
      <geometry><box size="0.040 0.040 0.003"/></geometry>
      <material name="caster_metal"/>
    </visual>
    <visual>
      <!-- mieng dem 16 mm giua de caster va day than -->
      <origin xyz="0 0 0.011" rpy="0 0 0"/>
      <geometry><box size="0.040 0.040 0.016"/></geometry>
      <material name="spacer_dark"/>
    </visual>
    <inertial>
      <mass value="0.02"/>
      <inertia ixx="1e-6" ixy="0" ixz="0" iyy="1e-6" iyz="0" izz="1e-6"/>
    </inertial>
  </link>
  <joint name="left_caster_plate_joint" type="fixed">
    <parent link="base_link"/>
    <child link="left_caster_plate"/>
    <origin xyz="-0.31 0.16 0.031" rpy="0 0 0"/>
  </joint>

  <link name="left_caster_fork">
    <visual>
      <origin xyz="-0.004 0 -0.009" rpy="0 0 0"/>
      <geometry><box size="0.022 0.018 0.018"/></geometry>
      <material name="caster_metal"/>
    </visual>
    <inertial>
      <origin xyz="-0.004 0 -0.009" rpy="0 0 0"/>
      <mass value="0.02"/>
      <inertia ixx="1e-6" ixy="0" ixz="0" iyy="1e-6" iyz="0" izz="1e-6"/>
    </inertial>
  </link>
  <joint name="left_caster_swivel_joint" type="continuous">
    <parent link="left_caster_plate"/>
    <child link="left_caster_fork"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
    <axis xyz="0 0 1"/>
    <dynamics damping="0.0005" friction="0.0"/>
  </joint>

  <link name="left_caster_wheel">
    <visual>
      <origin xyz="0 0 0" rpy="1.5708 0 0"/>
      <geometry><cylinder radius="0.0125" length="0.012"/></geometry>
      <material name="caster_white"/>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="1.5708 0 0"/>
      <geometry><cylinder radius="0.0125" length="0.012"/></geometry>
    </collision>
    <inertial>
      <mass value="0.02"/>
      <inertia ixx="0.00000102" ixy="0" ixz="0" iyy="0.00000156" iyz="0" izz="0.00000102"/>
    </inertial>
  </link>
  <joint name="left_caster_wheel_joint" type="continuous">
    <parent link="left_caster_fork"/>
    <child link="left_caster_wheel"/>
    <!-- truc banh lech ra sau 8 mm (trail), tam banh o z = 0.0125 so voi san -->
    <origin xyz="-0.008 0 -0.0185" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <dynamics damping="0.0001" friction="0.0"/>
  </joint>

  <!-- Caster phai -->
  <link name="right_caster_plate">
    <visual>
      <origin xyz="0 0 0.0015" rpy="0 0 0"/>
      <geometry><box size="0.040 0.040 0.003"/></geometry>
      <material name="caster_metal"/>
    </visual>
    <visual>
      <!-- mieng dem 16 mm giua de caster va day than -->
      <origin xyz="0 0 0.011" rpy="0 0 0"/>
      <geometry><box size="0.040 0.040 0.016"/></geometry>
      <material name="spacer_dark"/>
    </visual>
    <inertial>
      <mass value="0.02"/>
      <inertia ixx="1e-6" ixy="0" ixz="0" iyy="1e-6" iyz="0" izz="1e-6"/>
    </inertial>
  </link>
  <joint name="right_caster_plate_joint" type="fixed">
    <parent link="base_link"/>
    <child link="right_caster_plate"/>
    <origin xyz="-0.31 -0.16 0.031" rpy="0 0 0"/>
  </joint>

  <link name="right_caster_fork">
    <visual>
      <origin xyz="-0.004 0 -0.009" rpy="0 0 0"/>
      <geometry><box size="0.022 0.018 0.018"/></geometry>
      <material name="caster_metal"/>
    </visual>
    <inertial>
      <origin xyz="-0.004 0 -0.009" rpy="0 0 0"/>
      <mass value="0.02"/>
      <inertia ixx="1e-6" ixy="0" ixz="0" iyy="1e-6" iyz="0" izz="1e-6"/>
    </inertial>
  </link>
  <joint name="right_caster_swivel_joint" type="continuous">
    <parent link="right_caster_plate"/>
    <child link="right_caster_fork"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
    <axis xyz="0 0 1"/>
    <dynamics damping="0.0005" friction="0.0"/>
  </joint>

  <link name="right_caster_wheel">
    <visual>
      <origin xyz="0 0 0" rpy="1.5708 0 0"/>
      <geometry><cylinder radius="0.0125" length="0.012"/></geometry>
      <material name="caster_white"/>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="1.5708 0 0"/>
      <geometry><cylinder radius="0.0125" length="0.012"/></geometry>
    </collision>
    <inertial>
      <mass value="0.02"/>
      <inertia ixx="0.00000102" ixy="0" ixz="0" iyy="0.00000156" iyz="0" izz="0.00000102"/>
    </inertial>
  </link>
  <joint name="right_caster_wheel_joint" type="continuous">
    <parent link="right_caster_fork"/>
    <child link="right_caster_wheel"/>
    <origin xyz="-0.008 0 -0.0185" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <dynamics damping="0.0001" friction="0.0"/>
  </joint>

  <!-- ===== IMU MPU6050 ===== -->
  <link name="imu_link">
    <visual>
      <geometry><box size="0.021 0.016 0.003"/></geometry>
      <material name="imu_blue"/>
    </visual>
    <inertial>
      <mass value="0.005"/>
      <inertia ixx="1e-7" ixy="0" ixz="0" iyy="1e-7" iyz="0" izz="1e-7"/>
    </inertial>
  </link>
  <joint name="imu_joint" type="fixed">
    <parent link="base_link"/>
    <child link="imu_link"/>
    <origin xyz="0 0 0.08" rpy="0 0 0"/>
  </joint>

  <!-- ===== MA ArUco giua noc than xe (khop MARKER_OFFSET_MM trong config.py) ===== -->
  <link name="aruco_link">
    <visual>
      <geometry><box size="0.192 0.192 0.002"/></geometry>
      <material name="aruco_white"/>
    </visual>
    <inertial>
      <mass value="0.01"/>
      <inertia ixx="1e-6" ixy="0" ixz="0" iyy="1e-6" iyz="0" izz="1e-6"/>
    </inertial>
  </link>
  <joint name="aruco_joint" type="fixed">
    <parent link="base_link"/>
    <child link="aruco_link"/>
    <origin xyz="-0.17 0 0.301" rpy="0 0 0"/>
  </joint>

</robot>
